general: {
	configs_folder = "/etc/janus"
	plugins_folder = "/usr/lib/janus/plugins"
	transports_folder = "/usr/lib/janus/transports"
	events_folder = "/usr/lib/janus/events"
	loggers_folder = "/usr/lib/janus/loggers"
	log_to_stdout = true
	debug_level = 4
	admin_secret = "janusadmin"
	server_name = "janus-webrtc-player"
}

certificates: {
}

media: {
	rtp_port_range = "20000-20100"
}

nat: {
	nice_debug = false
	ice_lite = true
	ice_tcp = false
	full_trickle = true
	# Set to your public IP if behind NAT
	# nat_1_1_mapping = "1.2.3.4"
}

plugins: {
	disable = "libjanus_voicemail.so,libjanus_recordplay.so,libjanus_textroom.so,libjanus_nosip.so,libjanus_sip.so,libjanus_videocall.so,libjanus_videoroom.so,libjanus_echotest.so,libjanus_audiobridge.so"
}

transports: {
	disable = "libjanus_http.so,libjanus_pfunix.so,libjanus_nanomsg.so,libjanus_mqtt.so,libjanus_rabbitmq.so"
}

events: {
}

loggers: {
}

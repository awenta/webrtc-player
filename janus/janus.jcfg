general: {
	configs_folder = "/run/webrtc-player/janus"
	plugins_folder = "/opt/janus/lib/janus/plugins"
	transports_folder = "/opt/janus/lib/janus/transports"
	events_folder = "/opt/janus/lib/janus/events"
	loggers_folder = "/opt/janus/lib/janus/loggers"
	log_to_stdout = true
	debug_level = 4
	debug_colors = false
	server_name = "janus-webrtc-player"
	exit_on_dl_error = true
}

certificates: {
}

media: {
	rtp_port_range = "20000-20100"
	no_media_timer = 5
	nack_optimizations = true
}

nat: {
	nice_debug = false
	ice_lite = true
	ice_tcp = false
	full_trickle = false
	# __NAT_MAPPING__
}

plugins: {
	disable = "libjanus_voicemail.so,libjanus_recordplay.so,libjanus_textroom.so,libjanus_nosip.so,libjanus_sip.so,libjanus_videocall.so,libjanus_echotest.so,libjanus_audiobridge.so,libjanus_videoroom.so"
}

transports: {
	# Nginx owns port 8088; only the loopback WebSocket transport is needed.
	disable = "libjanus_http.so,libjanus_pfunix.so,libjanus_nanomsg.so,libjanus_mqtt.so,libjanus_rabbitmq.so"
}

events: {
}

loggers: {
}
